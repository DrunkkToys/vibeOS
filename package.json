{
  "name": "vibeostheog",
  "version": "0.25.28",
  "description": "Cost-aware delegation enforcer for OpenCode. Tracks model usage, routes Task subagents to cheaper tiers, surfaces cumulative savings in chat. Includes research audit, reporting framework, project memory, progressive scratchpad decadence, and trinity CLI for brain/medium/cheap slot switching.",
  "scripts": {
    "release": "node scripts/release.mjs",
    "release:patch": "node scripts/release.mjs patch --yes",
    "release:minor": "node scripts/release.mjs minor --yes",
    "release:major": "node scripts/release.mjs major --yes",
    "build": "npm run build:bundle && node scripts/deploy.mjs",
    "build:bundle": "tsc -p tsconfig.json && node scripts/sync-ts-build.mjs && node scripts/build-bundle.mjs",
    "build:single": "node scripts/build-bundle.mjs",
    "deploy": "node scripts/deploy.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "checkpoint:validate": "node scripts/checkpoint-validate.mjs",
    "test:scripts": "node scripts/run-test-suite.mjs scripts",
    "ts:audit": "node scripts/ts-audit.mjs",
    "test": "npm run build:bundle && node scripts/run-test-suite.mjs full",
    "test:ci": "npm run build:bundle && node scripts/run-test-suite.mjs ci",
    "guard": "bash plugins/vibetheog-guard/scripts/run-guard.sh",
    "guard:full": "VIBETHEOG_GUARD_FULL=1 bash plugins/vibetheog-guard/scripts/run-guard.sh",
    "hook:precommit": "bash plugins/vibetheog-guard/hooks/pre-commit.sh",
    "hook:summary": "bash plugins/vibetheog-guard/hooks/post-command-summary.sh",
    "precommit": "node scripts/pre-commit.mjs",
    "audit-state": "node scripts/audit-state.mjs",
    "migrate-ledger": "node scripts/migrate-ledger.mjs",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "test:coverage": "c8 --reporter=text --reporter=html npm test",
    "typecheck:strict": "tsc -p tsconfig.strict.json --noEmit"
  },
  "type": "module",
  "main": "./dist/vibeOS.js",
  "bin": {
    "vibeostheog": "bin/setup.js"
  },
  "exports": {
    ".": "./dist/vibeOS.js",
    "./server": "./dist/vibeOS.js",
    "./tui": "./.opencode/plugins/vibeOS-tui.tsx"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "cost",
    "delegation",
    "model-routing",
    "trinity"
  ],
  "author": "vibeOS",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "^1.15.7"
  },
  "files": [
    "dist/**/*",
    "bin/setup.js",
    ".opencode/plugins/vibeOS-tui.tsx",
    "scripts/deploy.mjs",
    "scripts/lib/**/*",
    "model-tiers.sample.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "!src/**/tests/**",
    "!src/**/*.test.*",
    "!src/vibeOS-lib/tests/**",
    "!src/vibeOS-lib/flow-rules.json"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DrunkkToys/vibeOS.git"
  },
  "homepage": "https://github.com/DrunkkToys/vibeOS#readme",
  "bugs": {
    "url": "https://github.com/DrunkkToys/vibeOS/issues"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.15.30",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "c8": "^11.0.0",
    "esbuild": "^0.28.0",
    "eslint": "^10.4.0",
    "express": "^5.2.1",
    "typescript": "^5.9.3"
  }
}
